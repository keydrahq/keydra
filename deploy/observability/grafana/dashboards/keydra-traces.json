{
  "uid": "keydra-traces",
  "title": "Keydra — traces",
  "description": "Every span Tempo has seen, as numbers: one per request and one per statement underneath it. This is where a slow endpoint turns out to be a slow query.",
  "tags": [
    "keydra"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Spans / s",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"keydra\"}[5m])) or vector(0)",
          "legendFormat": "keydra",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "From the browser",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"keydra-web\"}[5m])) or vector(0)",
          "legendFormat": "keydra-web",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "Spans the page produced. They carry the trace header on, so they are the same traces as the ones above.",
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Busiest operations",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"keydra\"}[5m])))",
          "legendFormat": "{{span_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Slowest operations",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (span_name) (rate(traces_spanmetrics_latency_sum{service=\"keydra\"}[5m]) / rate(traces_spanmetrics_latency_count{service=\"keydra\"}[5m])))",
          "legendFormat": "{{span_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Spans that ended badly",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"keydra\", status_code=\"STATUS_CODE_ERROR\"}[5m]))",
          "legendFormat": "{{span_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "An error here is a span the code marked as failed, which is not always a request that failed.",
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "How long a span takes",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"keydra\"}[5m])))",
          "legendFormat": "95th",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"keydra\"}[5m])))",
          "legendFormat": "median",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Every operation",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (span_name) (rate(traces_spanmetrics_latency_sum{service=\"keydra\"}[5m]) / rate(traces_spanmetrics_latency_count{service=\"keydra\"}[5m])))",
          "legendFormat": "{{span_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Mean duration by name. The SQL statements in here are Hibernate's, seen from inside the request that ran them.",
      "options": {
        "showHeader": true
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 10
      }
    }
  ],
  "editable": true
}

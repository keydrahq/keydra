{
  "uid": "keydra-requests",
  "title": "Keydra — requests",
  "description": "What is being asked of the API, how long it takes and how often it goes wrong.",
  "tags": [
    "keydra"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Requests / s",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "served",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Errors / s",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "failed",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "95th percentile",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "95th",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 3,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      }
    },
    {
      "type": "timeseries",
      "title": "By endpoint",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{uri}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "By outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "401 and 403 are the security model working, not a fault; 500 is not.",
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "How long, by percentile",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "median",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "95th",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "99th",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Slowest endpoints",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, sum by (uri) (rate(http_server_requests_seconds_sum[5m]) / rate(http_server_requests_seconds_count[5m])))",
          "legendFormat": "{{uri}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Where the time goes",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (uri, method) (rate(http_server_requests_seconds_sum[5m])))",
          "legendFormat": "{{method}} {{uri}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Seconds spent per second, which is the product of how slow and how often — the endpoint worth looking at first.",
      "options": {
        "showHeader": true
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 10
      }
    }
  ],
  "editable": true
}

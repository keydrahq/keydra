{
  "uid": "keydra-targets",
  "title": "Keydra — targets",
  "description": "The servers Keydra watches, as Keydra experiences them: how long a reading takes, how often one fails, and which target is the slow one.",
  "tags": [
    "keydra"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Up",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(keydra_targets{state=\"up\"}[1m])",
          "legendFormat": "{{keydra_instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Down",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(keydra_targets{state=\"down\"}[1m])",
          "legendFormat": "{{keydra_instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Readings / minute",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(keydra_target_sample_seconds_count[5m])) * 60",
          "legendFormat": "taken",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Across every target being sampled, whether a dashboard asked or a rule did.",
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 3,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Targets by state",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(keydra_targets[1m])",
          "legendFormat": "{{state}} · {{keydra_instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "What the health sweep last found. A target nobody is watching is in neither line.",
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Time to read a target",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(keydra_target_sample_seconds_sum[5m]) / rate(keydra_target_sample_seconds_count[5m])",
          "legendFormat": "mean · connection {{connection}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        },
        {
          "refId": "B",
          "expr": "keydra_target_sample_seconds_max",
          "legendFormat": "slowest · connection {{connection}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Dialling, waiting and parsing included — what a reading actually costs.",
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Readings taken",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(keydra_target_sample_seconds_count[5m]) * 60",
          "legendFormat": "per minute · connection {{connection}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        },
        {
          "refId": "B",
          "expr": "rate(keydra_target_sample_failures_total[5m]) * 60",
          "legendFormat": "failed · connection {{connection}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "A target that stops answering shows up here before it shows up anywhere else.",
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "barchart",
      "title": "Failures",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (connection) (increase(keydra_target_sample_failures_total[15m]))",
          "legendFormat": "connection {{connection}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Readings that did not come back, in fifteen-minute buckets.",
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Slowest to read",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, rate(keydra_target_sample_seconds_sum[5m]) / rate(keydra_target_sample_seconds_count[5m]))",
          "legendFormat": "connection {{connection}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "By connection id. Names are deliberately not in the metrics; the catalog resolves them.",
      "options": {
        "showHeader": true
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "logs",
      "title": "What the watching said",
      "datasource": {
        "type": "loki",
        "uid": "LOKI"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"keydra\"} | severity_text =~ \"WARN|ERROR\" |~ \"(?i)(connection|target|sampl)\"",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "LOKI"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 10
      }
    }
  ],
  "editable": true
}
